{:name "argy-bargy"
 :version "DEVEL"
 :description "A fancy command-line argument parser for Janet"
 :author "Michael Camilleri"
 :license "MIT"
 :url "https://github.com/pyrmont/argy-bargy"
 :repo "git+https://github.com/pyrmont/argy-bargy"
 :vendored [{:name "testament"
             :url "https://github.com/pyrmont/testament"
             :prefix "deps/testament"
             :paths ["lib/testament.janet"
                     "init.janet"
                     "LICENSE"]}]
 :artifacts {:libraries [{:paths "argy-bargy.janet"}]}}
